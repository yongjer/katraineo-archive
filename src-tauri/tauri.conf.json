{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katraineo",
  "version": "../package.json",
  "identifier": "io.github.yongjer.katraineo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Katraineo",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "BoardGame",
    "shortDescription": "Go analysis and training with KataGo",
    "fileAssociations": [
      {
        "ext": [
          "sgf"
        ],
        "name": "Smart Game Format",
        "description": "Go game record (SGF)",
        "mimeType": "application/x-go-sgf",
        "role": "Editor"
      },
      {
        "ext": [
          "gib"
        ],
        "name": "Tygem Go Game",
        "description": "Go game record (GIB)",
        "role": "Viewer"
      },
      {
        "ext": [
          "ngf"
        ],
        "name": "WBaduk Go Game",
        "description": "Go game record (NGF)",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/models/b10c384h6nbttflrs.bin.gz": "models/b10c384h6nbttflrs.bin.gz",
      "../resources/KataGo/analysis_config.cfg": "KataGo/analysis_config.cfg"
    },
    "windows": {
      "wix": {
        "version": "2.0.0"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRkVDM0JCRjQ1RUE0REUKUldUZXBGNzB1OFArTGhhOWdUaDE0Wm93blFkOUc5QWkzV3V0MGJEUmlLNWFWZHhqSDdiN05tKzYK",
      "endpoints": [
        "https://github.com/yongjer/katraineo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
